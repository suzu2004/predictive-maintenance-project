# Predictive Maintenance Project — .gitignore

# ---- Virtual environments ----
.venv/
.venv311/
venv/
env/
.env

# ---- Python cache ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Large data files (too big for Git) ----
