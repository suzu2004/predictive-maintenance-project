outputs/random_forest_model.pkl
outputs/scaler.pkl
outputs/test_predictions.csv

# ---- OS generated ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp

# ---- Streamlit secrets ----
.streamlit/secrets.toml
